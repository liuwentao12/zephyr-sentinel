/*
 * MAX32655FTHR onboard MAX9867 audio codec.
 */

&i2c1 {
	max9867: max9867@18 {
		compatible = "adi,max9867";
		reg = <0x18>;
	};
};

&uart0 {
    current-speed = <115200>;
};

/ {
    chosen {
        zephyr,display = &oled;
    };
};

&i2c2 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    
    oled: ssd1306@3c {
        compatible = "solomon,ssd1306";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
};